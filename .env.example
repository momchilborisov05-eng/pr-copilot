# Copy to .env and fill in. Without ANTHROPIC_API_KEY the app runs in demo mode (no model calls).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# auto (default): live when ANTHROPIC_API_KEY is set, otherwise demo. Force with demo | live.
PRCOPILOT_MODE=auto

# GitHub: webhook secret (Settings > Webhooks) and a token with pull-requests:write to post reviews.
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
PRCOPILOT_POST_TO_GITHUB=true

# Storage and limits
PRCOPILOT_DB=pr_copilot.db
PRCOPILOT_MAX_CHUNK_CHARS=24000
PRCOPILOT_MAX_FILES=60
PRCOPILOT_SEED_DEMO=true
