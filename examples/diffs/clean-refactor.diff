@@ -0,0 +1,19 @@
+import unittest
+
+from accounts.validators import ValidationError, normalize_email
+
+
+class NormalizeEmailTest(unittest.TestCase):
+    def test_trims_and_lowercases(self):
+        self.assertEqual(normalize_email("  Ana@Example.COM "), "ana@example.com")
+
+    def test_rejects_missing_at(self):
+        with self.assertRaises(ValidationError):
+            normalize_email("ana.example.com")
+
+    def test_rejects_spaces(self):
+        with self.assertRaises(ValidationError):
+            normalize_email("ana smith@example.com")
+
+    def test_error_is_a_value_error(self):
+        self.assertTrue(issubclass(ValidationError, ValueError))
