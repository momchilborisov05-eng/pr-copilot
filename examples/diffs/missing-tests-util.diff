@@ -0,0 +1,35 @@
+"""Small text and pagination helpers used by the catalogue views."""
+
+import re
+import unicodedata
+
+_NON_WORD = re.compile(r"[^a-z0-9]+")
+
+
+def slugify(value: str, max_length: int = 60) -> str:
+    """Turn 'Cafe Creme 250g' into 'cafe-creme-250g'."""
+    normalized = unicodedata.normalize("NFKD", value).encode("ascii", "ignore").decode()
+    slug = _NON_WORD.sub("-", normalized.lower()).strip("-")
+    return slug[:max_length]
+
+
+def paginate(items: list, page: int, per_page: int = 20) -> dict:
+    """Return one page of `items` plus paging metadata. Pages start at 1."""
+    start = (page - 1) * per_page
+    end = start + per_page
+    total_pages = len(items) // per_page
+    return {
+        "items": items[start:end],
+        "page": page,
+        "per_page": per_page,
+        "total": len(items),
+        "total_pages": total_pages,
+        "has_next": page < total_pages,
+    }
+
+
+def truncate_words(text: str, limit: int) -> str:
+    words = text.split()
+    if len(words) <= limit:
+        return text
+    return " ".join(words[:limit]) + "..."
